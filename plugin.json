{
  "formatVersion": 3,
  "id": "org.aimonitor.flights",
  "name": "Flights",
  "version": "1.0.0",
  "author": "AI Monitor contributors",
  "description": "Aircraft currently flying near the display's location, nearest first.",
  "viewLabel": "Flights",
  "attribution": "Flight data by adsb.lol contributors (ODbL 1.0)",
  "minSceneProtocol": 1,
  "source": {
    "url": "https://api.adsb.lol/v2/point/{location.latitude}/{location.longitude}/{radius}",
    "intervalSeconds": 20
  },
  "requires": ["location"],
  "lists": [
    {
      "name": "flights",
      "path": "ac",
      "sortBy": "dst",
      "limit": 3,
      "where": [
        {"path": "flight", "operator": "exists"},
        {"path": "alt_baro", "operator": "notEquals", "value": "ground"},
        {"path": "gs", "operator": "atLeast", "value": 40}
      ]
    }
  ],
  "attentionRules": [
    {"id": "flight-in-range", "path": "lists.flights.count", "operator": "atLeast", "value": 1}
  ],
  "settings": [
    {"key": "radius", "label": "Radius (nautical miles)", "kind": "number", "default": 15, "min": 1, "max": 40}
  ],
  "bindings": [
    {"name": "count", "path": "lists.flights.count", "format": "integer", "suffix": "", "map": {}, "fallback": "0"},
    {"name": "f1", "path": "lists.flights.items.0.flight", "format": "text", "suffix": "", "map": {}, "fallback": "", "trim": true},
    {"name": "t1", "path": "lists.flights.items.0.t", "format": "text", "suffix": "", "map": {}, "fallback": "-", "trim": true},
    {"name": "d1", "path": "lists.flights.items.0.dst", "format": "decimal1", "suffix": " km", "map": {}, "fallback": "", "scale": 1.852},
    {"name": "f2", "path": "lists.flights.items.1.flight", "format": "text", "suffix": "", "map": {}, "fallback": "", "trim": true},
    {"name": "t2", "path": "lists.flights.items.1.t", "format": "text", "suffix": "", "map": {}, "fallback": "-", "trim": true},
    {"name": "d2", "path": "lists.flights.items.1.dst", "format": "decimal1", "suffix": " km", "map": {}, "fallback": "", "scale": 1.852},
    {"name": "f3", "path": "lists.flights.items.2.flight", "format": "text", "suffix": "", "map": {}, "fallback": "", "trim": true},
    {"name": "t3", "path": "lists.flights.items.2.t", "format": "text", "suffix": "", "map": {}, "fallback": "-", "trim": true},
    {"name": "d3", "path": "lists.flights.items.2.dst", "format": "decimal1", "suffix": " km", "map": {}, "fallback": "", "scale": 1.852},
    {"name": "r1", "path": "lists.flights.items.0.r", "format": "text", "suffix": "", "map": {}, "fallback": "", "trim": true},
    {"name": "alt1", "path": "lists.flights.items.0.alt_baro", "format": "integer", "suffix": " m", "map": {}, "fallback": "", "scale": 0.3048},
    {"name": "spd1", "path": "lists.flights.items.0.gs", "format": "integer", "suffix": " km/h", "map": {}, "fallback": "", "scale": 1.852},
    {"name": "trk1", "path": "lists.flights.items.0.track", "format": "integer", "suffix": "", "map": {}, "fallback": "-"}
  ],
  "localizations": {
    "de": {"Flights": "Fluege", "Aircraft currently flying near the display's location, nearest first.": "Flugzeuge in der Naehe des Display-Standorts, das naechste zuerst.", "Flight data by adsb.lol contributors (ODbL 1.0)": "Flugdaten von adsb.lol und Mitwirkenden (ODbL 1.0)", "Radius (nautical miles)": "Radius (Seemeilen)", "FLIGHTS IN RANGE": "FLUEGE IM UMKREIS", "{{d1}}  heading {{trk1}}": "{{d1}}  Kurs {{trk1}}", "No flight in range": "Kein Flug in Reichweite", "Data: adsb.lol": "Daten: adsb.lol"}
  },
  "scenes": {
    "portrait": {
      "background": 1580575,
      "nodes": [
        {"type": "text", "x": 50, "y": 30, "w": 740, "h": 60, "color": 11250603, "font": 14, "text": "FLIGHTS IN RANGE"},
        {"type": "text", "x": 790, "y": 30, "w": 160, "h": 60, "color": 11250603, "font": 14, "text": "{{count}}", "align": "right"},
        {"type": "rect", "x": 50, "y": 100, "w": 900, "h": 4, "color": 3717119},
        {"type": "text", "x": 50, "y": 130, "w": 900, "h": 140, "color": 7324671, "font": 36, "text": "{{f1}}", "visibleWhen": {"binding": "count", "notEquals": "0"}},
        {"type": "text", "x": 50, "y": 275, "w": 900, "h": 75, "color": 16777215, "font": 16, "text": "{{t1}}  {{r1}}", "visibleWhen": {"binding": "count", "notEquals": "0"}},
        {"type": "text", "x": 50, "y": 370, "w": 900, "h": 75, "color": 16777215, "font": 16, "text": "{{alt1}}  {{spd1}}", "visibleWhen": {"binding": "count", "notEquals": "0"}},
        {"type": "text", "x": 50, "y": 450, "w": 900, "h": 75, "color": 11250603, "font": 16, "text": "{{d1}}  heading {{trk1}}", "visibleWhen": {"binding": "count", "notEquals": "0"}},
        {"type": "text", "x": 50, "y": 300, "w": 900, "h": 160, "color": 11250603, "font": 16, "text": "No flight in range", "visibleWhen": {"binding": "count", "equals": "0"}},
        {"type": "rect", "x": 50, "y": 565, "w": 900, "h": 4, "color": 3717119, "visibleWhen": {"binding": "f2", "notEquals": ""}},
